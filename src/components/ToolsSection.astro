---
import {
  siDocker,
  siFigma,
  siGit,
  siJavascript,
  siKubernetes,
  siLaravel,
  siLinux,
  siMysql,
  siNestjs,
  siNextdotjs,
  siNodedotjs,
  siPostgresql,
  siReact,
  siShadcnui,
  siTailwindcss,
  siTypescript,
  siZod,
} from "simple-icons";

import { getMessages } from "../i18n";
import ToolsGroup from "./ToolsGroup.astro";

const locale = Astro.currentLocale ?? "en";
const t = getMessages(locale);

const frontend = [
  { icon: siTypescript, name: "TypeScript" },
  { icon: siJavascript, name: "JavaScript" },
  { icon: siReact, name: "ReactJS" },
  { icon: siNextdotjs, name: "NextJS" },
  { icon: siTailwindcss, name: "TailwindCSS" },
  { icon: siZod, name: "Zod" },
  { icon: siShadcnui, name: "shadcn/ui" },
];

const backend = [
  { icon: siNodedotjs, name: "Node.js" },
  { icon: siNestjs, name: "NestJS" },
  { icon: siLaravel, name: "Laravel" },
  { icon: siPostgresql, name: "PostgreSQL" },
  { icon: siMysql, name: "MySQL" },
];

const others = [
  { icon: siDocker, name: "Docker" },
  { icon: siKubernetes, name: "Kubernetes" },
  { icon: siGit, name: "Git" },
  { icon: siLinux, name: "Linux" },
  { icon: siFigma, name: "Figma" },
];
---

<div class="flex flex-col gap-6">
  <ToolsGroup title={t.tools.frontend} tools={frontend} />
  <ToolsGroup title={t.tools.backend} tools={backend} />
  <ToolsGroup title={t.tools.others} tools={others} />
</div>
